{
  "schemaVersion": 1,
  "id": "titanium",
  "version": "${version}",
  "name": "Titanium",
  "description": "A native Apple Metal renderer for Minecraft on macOS (Apple silicon).",
  "authors": ["ethandadev"],
  "contact": {
    "homepage": "https://titanium.ethandadev.com",
    "sources": "https://github.com/ethandadev/Titanium"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["com.ethandadev.titanium.TitaniumClient"]
  },
  "mixins": ["titanium.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "1.21.11",
    "java": ">=21"
  }
}
